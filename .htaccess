<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|access_admin-1\.0\.0\.js|configuracoes_agendamento_online.*\.js|configuracoes_agendamento_online.*\.css|navigation_glass-1\.0\.0\.css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# O index legado mantém uma referência estável do bootstrap administrativo.
# Substituímos a revisão somente na resposta HTML para que mudanças do hub
# Configurações > Agenda recebam uma URL inequívoca sem reescrever o index inteiro.
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  Substitute "s|src/admin/access_admin-1.0.0.js?v=20260913-online-v4|src/admin/access_admin-1.0.0.js?v=20260913-config-agenda-r1|ni"
</IfModule>
